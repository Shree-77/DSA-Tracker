# --- Backend environment configuration ---
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit a real .env file with production secrets.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://dsa:dsa@localhost:5432/dsa_tracker

# Comma-separated list of allowed CORS origins.
# For Flutter web dev server / local testing use e.g. http://localhost:3000
# Use "*" only for local development, never in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Application environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Authentication ---
# Secret used to sign JWT access tokens. MUST be overridden in production with a
# long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with APP_ENV=production if this is left at the default.
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI (study-plan generation) ---
# Key used to ENCRYPT each user's provider API key at rest. MUST be set to a
# strong, STABLE value in production — rotating it makes existing stored keys
# unreadable (users would need to re-enter them). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with APP_ENV=production if this is left at default.
AI_ENCRYPTION_KEY=CHANGE_ME_INSECURE_AI_ENCRYPTION_KEY

# OpenAI-compatible provider endpoint. Default targets NVIDIA NIM (free keys
# available at https://build.nvidia.com). Users paste their own nvapi-... key
# in the app's Settings tab.
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model slug used when a user hasn't chosen one.
AI_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# Request timeout (seconds) and hard cap on generated plan length.
AI_REQUEST_TIMEOUT=60
AI_MAX_DAYS=180
