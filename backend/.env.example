# --- Backend environment configuration ---
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit a real .env file with production secrets.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://dsa:dsa@localhost:5432/dsa_tracker

# Comma-separated list of allowed CORS origins.
# For Flutter web dev server / local testing use e.g. http://localhost:3000
# Use "*" only for local development, never in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Application environment: development | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Authentication ---
# Secret used to sign JWT access tokens. MUST be overridden in production with a
# long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with APP_ENV=production if this is left at the default.
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
